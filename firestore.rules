rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── YORDAMCHI FUNKSIYALAR ─────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function activeUser() {
      return hasProfile() && myProfile().active == true;
    }

    function isAdmin() {
      return activeUser() && myProfile().role in ["admin", "sinf_rahbari", "oqituvchi", "observer"];
    }

    function isStrictAdmin() {
      return activeUser() && myProfile().role == "admin";
    }

    function isMentor() {
      return activeUser() && myProfile().role == "sinf_rahbari";
    }

    function isTeacher() {
      return activeUser() && myProfile().role == "oqituvchi";
    }

    function isStudent() {
      return activeUser() && myProfile().role == "student";
    }

    // ── KURSLAR TIZIMI (eski) ─────────────────────────────────────────────────

    // Foydalanuvchi profillari: o'zi yoki admin o'qiy oladi
    match /userProfiles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isStrictAdmin();
    }

    // Ommaviy: login talab etilmaydi
    match /groups/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin();
    }

    match /subjects/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin() || isMentor();
    }

    match /course_students/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin() || isMentor();
    }

    match /teachers/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin() || isMentor();
    }

    match /classMentors/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin();
    }

    match /courseAssignments/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin() || isMentor();
    }

    match /attendance/{docId} {
      allow read: if true;
      allow create, update: if isStrictAdmin() || isTeacher();
      allow delete: if isStrictAdmin();
    }

    match /grades/{docId} {
      allow read: if true;
      allow create, update: if isStrictAdmin() || isTeacher();
      allow delete: if isStrictAdmin();
    }

    match /students/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin() || isMentor();
    }

    match /courses/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin();
    }

    // Eski ro'yxatdan o'tish (kurslar uchun)
    match /registrations/{docId} {
      allow create: if signedIn();
      allow read, update: if signedIn() && (
        resource.data.anonUid == request.auth.uid || isAdmin()
      );
      allow delete: if isStrictAdmin();
      allow list: if isAdmin();
    }

    // ── REYTING TIZIMI ────────────────────────────────────────────────────────

    // O'quvchilar reytingi: HAMMA o'qiy oladi, faqat admin yozadi
    match /students_rating/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin();
    }

    // Reyting meta (oy, yangilash vaqti): HAMMA o'qiy oladi
    match /rating_meta/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin();
    }

    // ── TESTLAR TIZIMI ────────────────────────────────────────────────────────

    // Testlar: faol foydalanuvchilar o'qiy oladi
    match /tests/{testId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();

      // Savollar subkolleksiyasi
      match /questions/{questionId} {
        allow read: if activeUser();
        allow create, update, delete: if isAdmin();
      }
    }

    // Test natijalari: o'zi yoki admin ko'ra oladi, yozish — faol foydalanuvchi
    match /testResults/{resultId} {
      allow get: if signedIn() && (
        resource.data.studentUid == request.auth.uid || isAdmin()
      );
      allow list: if activeUser();
      allow create: if activeUser();
      allow update, delete: if isAdmin();
    }

    // Test reytingi (shaxsiy javoblarsiz): HAMMA o'qiy oladi
    match /testRating/{ratingId} {
      allow read: if true;
      allow create: if activeUser();
      allow update, delete: if isAdmin();
    }

    // Testlar uchun ro'yxatdan o'tish: anonim ham yoza oladi
    match /studentsTest/{docId} {
      allow create: if signedIn();
      allow get, update: if signedIn() && (
        resource.data.anonUid == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAdmin();
      allow delete: if isStrictAdmin();
    }

    // ── CATCH-ALL: qolgan hammasi taqiqlangan ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
