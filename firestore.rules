rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── YORDAMCHI FUNKSIYALAR ─────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function activeUser() {
      return hasProfile() && myProfile().active == true;
    }

    // Barcha faol XODIMLAR (admin/sinf_rahbari/oqituvchi/observer).
    // DIQQAT: bu "admin" emas — faqat tizimga kirgan xodim degani.
    function isStaff() {
      return activeUser() && myProfile().role in ["admin", "sinf_rahbari", "oqituvchi", "observer"];
    }

    function isStrictAdmin() {
      return activeUser() && myProfile().role == "admin";
    }

    function isMentor() {
      return activeUser() && myProfile().role == "sinf_rahbari";
    }

    function isTeacher() {
      return activeUser() && myProfile().role == "oqituvchi";
    }

    function isStudent() {
      return activeUser() && myProfile().role == "student";
    }

    // O'qituvchining profilidagi 'id' — string ko'rinishida.
    function myTeacherId() {
      return string(myProfile().id);
    }

    // ── FOYDALANUVCHI PROFILLARI ──────────────────────────────────────────────
    // O'zi yoki faqat admin o'qiy oladi (xodimlar bir-birining profilini ko'rmaydi).
    match /userProfiles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isStrictAdmin());
      allow create, update, delete: if isStrictAdmin();
    }

    // ── OMMAVIY (MAXFIY EMAS) MA'LUMOTNOMALAR ─────────────────────────────────
    // Bular shaxsiy ma'lumot emas (fan/guruh nomlari, ommaviy reyting taxtasi).
    match /groups/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin();
    }

    match /subjects/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin();
    }

    match /students_rating/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin();
    }

    match /rating_meta/{docId} {
      allow read: if true;
      allow create, update, delete: if isStrictAdmin();
    }

    // ── O'QUVCHILAR PII SI: FAQAT FAOL XODIMLAR O'QIY OLADI ───────────────────
    // O'quvchi ismi, guruhi, davomati, baholari — ommaga ochiq EMAS.

    match /students/{docId} {
      allow read: if activeUser();
      allow create, update, delete: if isStrictAdmin() || isMentor();
    }

    match /course_students/{docId} {
      allow read: if activeUser();
      allow create, update, delete: if isStrictAdmin() || isMentor();
    }

    match /teachers/{docId} {
      allow read: if activeUser();
      allow create, update, delete: if isStrictAdmin();
    }

    match /classMentors/{docId} {
      allow read: if activeUser();
      allow create, update, delete: if isStrictAdmin();
    }

    match /courseAssignments/{docId} {
      allow read: if activeUser();
      allow create, update, delete: if isStrictAdmin() || isMentor();
    }

    match /courses/{docId} {
      allow read: if activeUser();
      allow create, update, delete: if isStrictAdmin();
    }

    // ── DAVOMAT — egalik majburlanadi ─────────────────────────────────────────
    // O'qituvchi faqat O'ZIGA tegishli (teacherId == o'z id) davomatni yoza oladi.
    match /attendance/{docId} {
      allow read: if activeUser();
      allow create: if isStrictAdmin()
        || (isTeacher() && request.resource.data.teacherId == myTeacherId());
      allow update: if isStrictAdmin()
        || (isTeacher()
            && resource.data.teacherId == myTeacherId()
            && request.resource.data.teacherId == myTeacherId());
      allow delete: if isStrictAdmin();
    }

    // ── BAHOLAR — egalik majburlanadi ─────────────────────────────────────────
    match /grades/{docId} {
      allow read: if activeUser();
      allow create: if isStrictAdmin()
        || (isTeacher() && request.resource.data.teacherId == myTeacherId());
      allow update: if isStrictAdmin()
        || (isTeacher()
            && resource.data.teacherId == myTeacherId()
            && request.resource.data.teacherId == myTeacherId());
      allow delete: if isStrictAdmin();
    }

    // Eski ro'yxatdan o'tish (kurslar uchun) — faqat xodim/admin.
    match /registrations/{docId} {
      allow create: if signedIn();
      allow read, update: if signedIn() && (
        resource.data.anonUid == request.auth.uid || isStrictAdmin()
      );
      allow delete: if isStrictAdmin();
      allow list: if isStrictAdmin();
    }

    // ── CATCH-ALL: qolgan hammasi taqiqlangan ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
